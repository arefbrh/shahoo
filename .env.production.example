# SHAHOO production environment template.
# Docker Compose uses POSTGRES_* to create its private PostgreSQL container.
# For native Windows/Linux Node deployments, set DATABASE_URL to the local PostgreSQL URL.
# Generate passwords with: openssl rand -hex 32

POSTGRES_DB=shahoo_db
POSTGRES_USER=shahoo_admin
POSTGRES_PASSWORD=replace_with_admin_64_character_hex_password
APP_DB_USER=shahoo_app
APP_DB_PASSWORD=replace_with_app_64_character_hex_password

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_URL=https://organicshahoo.ir
APP_DOMAIN=organicshahoo.ir
SHAHOO_TRUST_PROXY=1

# Native (non-Docker) deployment only; Docker Compose constructs DATABASE_URL internally.
DATABASE_URL=postgresql://shahoo_app:replace_with_app_64_character_hex_password@127.0.0.1:5432/shahoo_db
# Native Windows/Linux restore only: admin role with CREATEDB and database-drop privileges.
RESTORE_DATABASE_URL=postgresql://shahoo_admin:replace_with_admin_64_character_hex_password@127.0.0.1:5432/shahoo_db

# Persistent local media storage. Keep this on a backed-up persistent volume.
STORAGE_PROVIDER=local
ALLOW_LOCAL_STORAGE=true
STORAGE_LOCAL_DIR=/app/storage/media

# Optional S3-compatible storage. Configure all values together before selecting s3.
# STORAGE_PROVIDER=s3
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_PREFIX=media
# Neon Object Storage also supplies AWS-standard names; the adapter accepts either form.
# Keep the bucket name explicit because Neon does not inject a default bucket.
# STORAGE_S3_BUCKET=shahoo-media
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# PayPing remains disabled until the merchant account and sandbox are verified.
PAYMENT_PROVIDER=
PAYPING_API_KEY=
PAYPING_LIVE=0
PAYPING_RETURN_URL=https://organicshahoo.ir/api/payment/payping/callback

# SMS remains disabled until the SMS.ir Verify template and credentials are verified.
SMS_PROVIDER=
SMS_MODE=disabled
SMS_LIVE=0
SMS_API_KEY=
SMS_SENDER=
SMS_IR_API_KEY=
SMS_IR_OTP_TEMPLATE_ID=

# Optional first-admin bootstrap values; keep the password hash generated offline.
SHAHOO_ADMIN_EMAIL=
SHAHOO_ADMIN_PASSWORD_HASH=
SHAHOO_ADMIN_NAME=
SHAHOO_ADMIN_MOBILE=
SHAHOO_ADMIN_ROTATE=
SHAHOO_ADMIN_RECOVER=

# Production migrations require a one-time explicit override on the migrate command.
SHAHOO_ALLOW_PRODUCTION_MIGRATE=0

# Worker cadence in seconds.
WORKER_INTERVAL_SECONDS=300
WORKER_TASK_TIMEOUT_SECONDS=240

# Optional host-side monitoring alerts (used by scripts/linux and scripts/windows).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BALE_WEBHOOK_URL=
