<?xml version="1.0" encoding="UTF-8"?>
<!-- 
  SHAHOO Windows Server IIS Configuration
  Reverse Proxy from IIS (Port 80/443) to Node.js / Nitro Server (Port 3000)
  Requirements: IIS URL Rewrite 2.1 & Application Request Routing (ARR) enabled.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ReverseProxyToShahooApp" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>

    <httpErrors existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" /> <!-- 50 MB max upload limit -->
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
