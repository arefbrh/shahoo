# SHAHOO environment template. Copy to a local file outside the repository.
# Do not put real passwords, tokens, or connection strings in this file.

# --- Required in production ---
# Postgres connection string. Production refuses to start when this is empty.
# Embedded PGlite is only for local development and tests.
DATABASE_URL=

# Public site origin used for absolute SEO links. Example: https://shahoo.example
APP_URL=
# Hostname used by Caddy for TLS/site routing; keep it aligned with APP_URL.
APP_DOMAIN=shop.example.com

# Set to 1 only for the explicit production migration command:
#   NODE_ENV=production SHAHOO_ALLOW_PRODUCTION_MIGRATE=1 npm run db:migrate
# npm run build does not migrate.
SHAHOO_ALLOW_PRODUCTION_MIGRATE=

# --- First admin (optional until an operator is ready) ---
# Password hash is produced by: node scripts/hash-admin-password.mjs
# Format: s2$<salt>$<hash>
SHAHOO_ADMIN_EMAIL=
SHAHOO_ADMIN_PASSWORD_HASH=
SHAHOO_ADMIN_NAME=
SHAHOO_ADMIN_MOBILE=
# SHAHOO_ADMIN_ROTATE=1 updates the password of an already-active admin.
# SHAHOO_ADMIN_RECOVER=1 reactivates a suspended admin and restores super_admin.
# Leave both unset in normal operation.
SHAHOO_ADMIN_ROTATE=
SHAHOO_ADMIN_RECOVER=

# --- Development only. Ignored or rejected when NODE_ENV=production ---
# SEED_DEMO=1 loads the sample catalog and demo coupons. Never in production.
SEED_DEMO=
# ECHO_OTP=1 returns the OTP code in the login response when SMS is not configured.
ECHO_OTP=
# ALLOW_MOCK_PAYMENT=1 plus PAYMENT_PROVIDER=mock enables the fake payment provider.
ALLOW_MOCK_PAYMENT=
# ALLOW_MOCK_SMS=1 plus SMS_PROVIDER=mock enables a no-network SMS stub.
ALLOW_MOCK_SMS=
# ALLOW_DEV_CSP=1 relaxes CSP for the local preview shell. npm run dev sets this.
ALLOW_DEV_CSP=

# --- Payments (PayPing is source-integrated but remains disabled until controlled verification) ---
# Leave PAYMENT_PROVIDER empty by default. mock is ignored in production.
PAYMENT_PROVIDER=
ZARINPAL_MERCHANT_ID=
ZIBAL_MERCHANT=
IDPAY_API_KEY=
PAYPING_API_KEY=
PAYPING_RETURN_URL=
PAYPING_LIVE=

# --- SMS ---
# Explicit modes: disabled (default), sandbox (mock only; no provider request), or live.
SMS_MODE=disabled
# SMS.ir OTP uses its approved Verify template. Live calls require production + SMS_MODE=live + SMS_LIVE=1.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=
SMS_LIVE=
SMS_IR_API_KEY=
SMS_IR_OTP_TEMPLATE_ID=

# --- Storage ---
# Production local disk stays off unless ALLOW_LOCAL_STORAGE=true and the host can persist files.
STORAGE_PROVIDER=
STORAGE_LOCAL_DIR=
ALLOW_LOCAL_STORAGE=
# Neon Object Storage can use its native AWS-standard variable names:
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# STORAGE_S3_BUCKET=shahoo-media

# Optional oil knowledge integration. Keep disabled until the v3.2 dataset is imported,
# approved public views exist, and product-to-oil links are explicitly reviewed.
# Use a dedicated login role with SELECT on oil_encyclopedia public views only.
OIL_ENCYCLOPEDIA_ENABLED=false
OIL_ENCYCLOPEDIA_DATABASE_URL=
# One-time import only; use an isolated Neon Staging/integration branch and a privileged import role.
# Extract the owner-supplied v3.2 ZIP first; never point this at Production.
OIL_ENCYCLOPEDIA_SOURCE_DIR=
OIL_ENCYCLOPEDIA_IMPORT_URL=
OIL_ENCYCLOPEDIA_TARGET_BRANCH=

# Trust X-Forwarded-For only behind a proxy that overwrites it.
SHAHOO_TRUST_PROXY=

# Platform scaffold flag. SHAHOO customer and admin login do not use Better Auth.
# Keep this false.
VITE_AUTH_ENABLED=false
# Only if a future authorized platform-scaffold integration is enabled, inject
# its client credentials securely at runtime. Never commit their values.
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
GROK_PREVIEW_CLIENT_SECRET=
